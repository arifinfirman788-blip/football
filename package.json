{
  "name": "kefu-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "vite build && node scripts/inline-dist-assets.mjs",
    "build:test": "vite build --mode test && node scripts/inline-dist-assets.mjs",
    "preview": "vite preview",
    "clean": "rm -rf football",
    "lint": "tsc --noEmit",
    "test:kefu-time": "node scripts/check-kefu-message-time.mjs",
    "test:kefu-ui": "node scripts/check-kefu-mobile-ui.mjs",
    "test:kefu-history": "node scripts/check-kefu-unified-history.mjs",
    "test:kefu-upload": "node scripts/check-kefu-mobile-upload.mjs",
    "test:kefu-ai-stop": "node scripts/check-kefu-ai-stop.mjs",
    "test:kefu-agent-display": "node scripts/check-kefu-agent-display.mjs",
    "test:kefu-human-mode": "node scripts/check-kefu-human-mode.mjs",
    "test:kefu-emoji": "node scripts/check-kefu-emoji-mapping.mjs",
    "zip": "find football \\( -name '__MACOSX' -o -name '.DS_Store' \\) -exec rm -rf {} + && rm -f football.zip && zip -r football.zip football -x '__MACOSX/*' '*.DS_Store'"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "lucide": "^1.46.0",
    "vite": "^6.2.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.8.2"
  }
}
